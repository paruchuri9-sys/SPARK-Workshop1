{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      "$sessionId": {
        "owner": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('sessions').child($sessionId).child('owner').val() === auth.uid"
        },
        "published": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('sessions').child($sessionId).child('owner').val() === auth.uid"
        },
        "presence": {
          ".read": "auth != null && root.child('sessions').child($sessionId).child('owner').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "responses": {
      "$sessionId": {
        ".read": "auth != null && root.child('sessions').child($sessionId).child('owner').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "exitTickets": {
      "$sessionId": {
        ".read": "auth != null && root.child('sessions').child($sessionId).child('owner').val() === auth.uid",
        "$ticketId": {
          ".write": "auth != null && root.child('sessions').child($sessionId).child('state').exists() && !data.exists()",
          ".validate": "newData.hasChildren(['q1','q2','q3','q4','q5'])",
          "q1": {
            ".validate": "newData.isString() && newData.val().length <= 1200"
          },
          "q2": {
            ".validate": "newData.isString() && newData.val().length <= 1200"
          },
          "q3": {
            ".validate": "newData.isString() && newData.val().length <= 1200"
          },
          "q4": {
            ".validate": "newData.isString() && newData.val().length <= 1200"
          },
          "q5": {
            ".validate": "newData.isString() && newData.val().length <= 1200"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
